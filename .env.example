# Copy to .env.local for local dev. On Vercel, the Supabase integration sets these for you.
# Supabase → Project Settings → API. The anon/publishable key is safe in the browser;
# row level security (supabase/migrations) protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ── Server only. NEVER prefix these with NEXT_PUBLIC_. ──
# Supabase → Project Settings → API → service_role. Used by the payment webhook to record purchases.
SUPABASE_SERVICE_ROLE_KEY=

# Dodo Payments (dashboard → Developer). Start in test mode.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_PRODUCT_ID=pdt_xxx
DODO_PAYMENTS_ENVIRONMENT=test_mode
