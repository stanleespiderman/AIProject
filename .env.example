# Copy to .env.local for local dev. On Vercel, the Supabase integration sets these for you.
# Supabase → Project Settings → API. The anon/publishable key is safe in the browser;
# row level security (supabase/migrations) protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Never prefix the service role key with NEXT_PUBLIC_. It is only for the
# server route that verifies payments (not built yet).
# SUPABASE_SERVICE_ROLE_KEY=
