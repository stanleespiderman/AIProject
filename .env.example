# Copy to .env.local for local dev. On Vercel, add the same two variables in
# Project Settings > Environment Variables. Both are safe to expose in the browser:
# the database is protected by row level security (see supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# SERVER-ONLY (no NEXT_PUBLIC_ prefix, never expose it). Needed for "Delete account".
# Supabase > Project Settings > API > service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Dodo Payments (server-only, never NEXT_PUBLIC_). See README > "Dodo Payments setup". ──
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_ID=pdt_xxx
DODO_PAYMENTS_RETURN_URL=https://yourdomain.com/unlock
# test_mode (default) or live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Optional: point the SDK at a proxy or local mock instead (then DODO_PAYMENTS_ENVIRONMENT is ignored).
# DODO_PAYMENTS_BASE_URL=
